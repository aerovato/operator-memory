  "scripts": {
    "build": "bun ./scripts/build.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.4"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.4",
    "@opentui/core": ">=0.4.5",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
