{
  "name": "@aerovato/operator-opencode",
  "version": "1.0.3",
  "description": "Operator Memory: durable context for agent-driven development.",
  "license": "BSD-3-Clause",
  "author": "Aerovato Research",
  "homepage": "https://github.com/aerovato/operator-memory#readme",
  "bugs": {
    "url": "https://github.com/aerovato/operator-memory/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "memory",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aerovato/operator-memory.git",
    "directory": "packages/opencode"
  },
  "engines": {
