{
  "name": "@aerovato/operator-pi",
  "version": "1.0.0",
  "description": "Operator Memory adapter for Pi.",
  "license": "BSD-3-Clause",
  "author": "Aerovato Research",
  "homepage": "https://github.com/aerovato/operator-memory#readme",
  "bugs": {
    "url": "https://github.com/aerovato/operator-memory/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "pi",
    "pi-package",
    "memory",
    "plugin"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aerovato/operator-memory.git",
    "directory": "packages/pi"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ./scripts/build.ts",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@aerovato/operator-core": "workspace:*"
  }
}
