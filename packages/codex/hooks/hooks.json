{
  "description": "Inject Operator Memory into Codex sessions and delegated subagents.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ": \"Render the Operator Memory preamble\"; node \"$PLUGIN_ROOT/dist/hook.js\"",
            "commandWindows": "REM Render the Operator Memory preamble & node \"%PLUGIN_ROOT%\\dist\\hook.js\"",
            "timeout": 120,
            "additionalContextLimit": 0,
            "statusMessage": "Loading the Operator Memory preamble"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ": \"Render the Operator Memory preamble\"; node \"$PLUGIN_ROOT/dist/hook.js\"",
            "commandWindows": "REM Render the Operator Memory preamble & node \"%PLUGIN_ROOT%\\dist\\hook.js\"",
            "timeout": 120,
            "additionalContextLimit": 0,
            "statusMessage": "Loading the Operator Memory preamble"
          }
        ]
      }
    ]
  }
}
