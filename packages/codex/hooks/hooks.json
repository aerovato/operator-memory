{
  "description": "Inject Operator Memory into Codex sessions and delegated subagents.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/dist/hook.js\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\hook.js\"",
            "timeout": 120,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/dist/hook.js\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\hook.js\"",
            "timeout": 120,
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
