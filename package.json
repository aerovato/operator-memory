{
  "name": "operator-memory",
  "version": "0.0.0",
  "private": true,
  "description": "Operator Memory: Durable context for agent-driven development.",
  "license": "BSD-3-Clause",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:helper": "bun run --cwd packages/helper build",
    "build:opencode": "bun run --cwd packages/opencode build",
    "build:opencode-v2": "bun run --cwd packages/opencode-v2 build",
    "build:opencode-v2:dev": "OPERATOR_PLUGIN_ID=aerovato.operator-memory-dev bun run --cwd packages/opencode-v2 build",
    "build:pi": "bun run --cwd packages/pi build",
    "build:codex": "bun run --cwd packages/codex build",
    "build:claude-code": "bun run --cwd packages/claude-code build",
    "build:deepseek": "bun run --cwd packages/deepseek build",
    "preview:opencode": "bun ./scripts/preview-opencode.ts",
    "preview:codex": "bun ./scripts/preview-codex.ts",
    "preview:claude-code": "bun ./scripts/preview-claude-code.ts",
    "install:helper": "bun run build:helper && bun link --cwd packages/helper",
    "install:opencode": "bun run build:opencode && bun ./scripts/install-opencode.ts",
    "install:pi": "bun run build:pi && bun ./scripts/install-pi.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "./scripts/check.sh",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "publish:helper": "sh scripts/publish-helper.sh",
    "publish:opencode": "sh scripts/publish-opencode.sh",
    "publish:opencode-v2": "sh scripts/publish-opencode-v2.sh",
    "publish:pi": "sh scripts/publish-pi.sh",
    "publish:codex": "sh scripts/publish-codex.sh",
    "publish:claude-code": "sh scripts/publish-claude-code.sh",
    "publish:deepseek": "sh scripts/publish-deepseek.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aerovato/operator-memory.git"
  },
  "author": "Aerovato Research",
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@opencode-ai/plugin": "^1.18.4",
    "@types/node": "^26.1.1",
    "memfs": "^4.64.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@types/bun": "^1.3.14"
  }
}
