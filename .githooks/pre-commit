#!/bin/sh

set -eu

# Git captures hook output instead of writing it to a terminal, so color
# escape codes render as literal escape characters. Disable color globally.
NO_COLOR=1
FORCE_COLOR=0
export NO_COLOR FORCE_COLOR

if ! bun run format:check; then
  bun run format
  echo "Formatting issues detected. Please stage the formatted files."
  exit 1
fi

if ! bun run lint; then
  echo "Linting failed."
  exit 1
fi

if ! bun run typecheck; then
  echo "Type check failed."
  exit 1
fi

if ! bun run test; then
  echo "Tests failed."
  exit 1
fi

echo "All checks passed."
